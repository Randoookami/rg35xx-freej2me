 unsigned int frameBufferSize = MAX_WIDTH * MAX_HEIGHT * 3;
 unsigned int frame[MAX_WIDTH * MAX_HEIGHT];
 unsigned char frameBuffer[MAX_WIDTH * MAX_HEIGHT * 3];
+
+/* RG35XX: convert internal XRGB8888 to frontend RGB565. */
+static unsigned short frameRGB565[MAX_WIDTH * MAX_HEIGHT];
+
+static void submit_frame_rgb565(void)
+{
+    unsigned int i;
+    unsigned int count = frameWidth * frameHeight;
+
+    for (i = 0; i < count; i++)
+    {
+        unsigned int c = frame[i];
+
+        frameRGB565[i] = (unsigned short)(
+            ((c >> 8) & 0xF800u) |
+            ((c >> 5) & 0x07E0u) |
+            ((c >> 3) & 0x001Fu));
+    }
+
+    Video(frameRGB565, frameWidth, frameHeight,
+          sizeof(unsigned short) * frameWidth);
+}
